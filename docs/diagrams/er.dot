digraph G {graph[rankdir=TB,pad="0.2"];node[shape=record,fontname="DejaVu Sans",fontsize=11,color=black];U[label="{users|PK id (INTEGER)|UQ username (TEXT NOCASE)|password_hash (TEXT)|created_at (TEXT)}"];T[label="{tasks|PK id (INTEGER)|FK creator_id (INTEGER)|FK assignee_id (INTEGER)|title (TEXT)|description (TEXT)|completed (INTEGER)|priority (TEXT)|due_date (optional TEXT)|created_at (TEXT)}"];U->T[label="creator_id + assignee_id  (each: 1-to-many)"];}
