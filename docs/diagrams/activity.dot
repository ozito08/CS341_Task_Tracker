digraph G {graph[rankdir=TB,pad=".2"];node[shape=box,fontname="DejaVu Sans",fontsize=10];edge[color=black];start[shape=ellipse,label="Start"];login[label="Sign in"];list[label="List visible tasks"];choice[shape=diamond,label="Action?"];new[label="Create / assign task"];edit[label="Edit or delete (creator)"];toggle[label="Toggle status (creator / assignee)"];refresh[label="Refresh task list"];end[shape=ellipse,label="End"];start->login->list->choice;choice->new[label="Create"];choice->edit[label="Edit/Delete"];choice->toggle[label="Complete"];new->refresh;edit->refresh;toggle->refresh;refresh->end;}
