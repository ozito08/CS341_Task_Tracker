digraph G {graph[rankdir=TB,pad=".2"];node[shape=box,fontname="DejaVu Sans",fontsize=10];edge[color=black];n1[label="1. Assignee selects Toggle Complete"];n2[label="2. MainFrame calls controller.toggle(id)"];n3[label="3. Service checks creator / assignee role"];n4[label="4. Repository executes conditional UPDATE"];n5[label="5. SQLite returns affected row count"];n6[label="6. UI refreshes or displays error"];n1->n2->n3->n4->n5->n6;}
